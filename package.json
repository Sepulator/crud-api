{
  "name": "crud-api",
  "version": "1.0.0",
  "description": "Simple CRUD API using in-memory database underneath, without frameworks.",
  "keywords": [
    "crud",
    "api",
    "nodejs"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "homepage": "https://github.com/Sepulator/crud-api#readme",
  "bugs": {
    "url": "https://github.com/Sepulator/crud-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sepulator/crud-api.git"
  },
  "license": "ISC",
  "author": "Yuri Skrypal",
  "scripts": {
    "start:dev": "nodemon --exec \"node -r ts-node/register -r tsconfig-paths/register src/index.ts\"",
    "start:prod": "webpack && node dist/bundle.js",
    "lint": "eslint src --ext .ts --max-warnings=0",
    "format": "prettier . --write",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "start:multi": "nodemon --exec \"node -r ts-node/register -r tsconfig-paths/register src/load-balancer.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.9.2",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "prettier": "3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-node-externals": "^3.0.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "uuid": "^13.0.0"
  }
}